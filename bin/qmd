#!/bin/sh
# Resolve npm/pnpm/Bun bin symlinks before selecting a runtime. Keep argv intact.
set -eu
SOURCE="$0"
LINKS=0
while [ -L "$SOURCE" ]; do
  LINKS=$((LINKS + 1))
  if [ "$LINKS" -gt 40 ]; then
    printf '%s\n' 'error: qmd launcher symlink cycle' >&2
    exit 1
  fi
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  TARGET="$(readlink "$SOURCE")"
  case "$TARGET" in
    /*) SOURCE="$TARGET" ;;
    *) SOURCE="$SOURCE_DIR/$TARGET" ;;
  esac
done
DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
ENTRY="$DIR/dist/cli/qmd.js"
if [ ! -f "$ENTRY" ]; then
  printf '%s\n' "error: qmd build missing at $ENTRY; run npm run build in a source checkout or reinstall the package" >&2
  exit 1
fi

# QMD_RUNTIME is an explicit override for installs whose package manager did not
# retain lockfile metadata. BUN_INSTALL means only that Bun exists, not that its
# native ABI was used. Actual npm/pnpm install metadata outranks a shipped lock.
case "${QMD_RUNTIME:-}" in
  node|bun) RUNTIME="$QMD_RUNTIME" ;;
  '')
    if [ -f "$DIR/package-lock.json" ] || [ -f "$DIR/node_modules/.package-lock.json" ] || [ -f "$DIR/node_modules/.modules.yaml" ]; then
      RUNTIME=node
    elif [ -f "$DIR/bun.lock" ] || [ -f "$DIR/bun.lockb" ]; then
      RUNTIME=bun
    else
      RUNTIME=node
      # Published packages omit repository locks. Discover the nearest actual
      # installation root, including pnpm's nested node_modules layout.
      PARENT="$(dirname "$DIR")"
      while [ "$PARENT" != / ]; do
        if [ "$(basename "$PARENT")" = node_modules ]; then
          INSTALL_ROOT="$(dirname "$PARENT")"
          if [ -f "$PARENT/.package-lock.json" ] || [ -f "$PARENT/.modules.yaml" ] || [ -f "$INSTALL_ROOT/package-lock.json" ]; then
            RUNTIME=node
            break
          elif [ -f "$INSTALL_ROOT/bun.lock" ] || [ -f "$INSTALL_ROOT/bun.lockb" ]; then
            RUNTIME=bun
            break
          fi
        fi
        PARENT="$(dirname "$PARENT")"
      done
    fi
    ;;
  *) printf '%s\n' 'error: QMD_RUNTIME must be node or bun' >&2; exit 1 ;;
esac
if ! command -v "$RUNTIME" >/dev/null 2>&1; then
  printf '%s\n' "error: qmd requires $RUNTIME on PATH (or select an installed runtime with QMD_RUNTIME=node|bun)" >&2
  exit 127
fi
exec "$RUNTIME" "$ENTRY" "$@"
