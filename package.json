{
  "name": "@tobilu/qmd",
  "version": "2.1.0",
  "description": "Query Markup Documents - On-device hybrid search for markdown files with BM25, vector search, and LLM reranking",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "qmd": "bin/qmd"
  },
  "files": [
    "bin/",
    "dist/",
    "scripts/",
    "!scripts/**/__pycache__/",
    "!scripts/**/*.pyc",
    "!scripts/**/*.pyo",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepare": "node scripts/prepare.mjs",
    "prepack": "node scripts/build.mjs",
    "build": "node scripts/build.mjs",
    "hooks:install": "bash scripts/install-hooks.sh",
    "test:launcher": "bash test/launcher-detection.test.sh",
    "test:package": "bash test/smoke-install.sh",
    "test": "node node_modules/vitest/vitest.mjs run --reporter=verbose test/",
    "qmd": "node --import tsx src/cli/qmd.ts",
    "index": "node --import tsx src/cli/qmd.ts index",
    "vector": "node --import tsx src/cli/qmd.ts vector",
    "search": "node --import tsx src/cli/qmd.ts search",
    "vsearch": "node --import tsx src/cli/qmd.ts vsearch",
    "rerank": "node --import tsx src/cli/qmd.ts rerank",
    "inspector": "npx @modelcontextprotocol/inspector node --import tsx src/cli/qmd.ts mcp",
    "release": "./scripts/release.sh"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shersingh7/qmd-mlx-search.git"
  },
  "homepage": "https://github.com/shersingh7/qmd-mlx-search#readme",
  "bugs": {
    "url": "https://github.com/shersingh7/qmd-mlx-search/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "better-sqlite3": "12.8.0",
    "fast-glob": "3.3.3",
    "node-llama-cpp": "3.22.3",
    "picomatch": "4.0.4",
    "sqlite-vec": "0.1.9",
    "web-tree-sitter": "0.26.7",
    "yaml": "2.8.3",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "sqlite-vec-darwin-arm64": "0.1.9",
    "sqlite-vec-darwin-x64": "0.1.9",
    "sqlite-vec-linux-arm64": "0.1.9",
    "sqlite-vec-linux-x64": "0.1.9",
    "sqlite-vec-windows-x64": "0.1.9",
    "tree-sitter-go": "0.23.4",
    "tree-sitter-python": "0.23.4",
    "tree-sitter-rust": "0.24.0",
    "tree-sitter-typescript": "0.23.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/bun": "1.3.8",
    "@types/node": "24.10.1",
    "@types/picomatch": "4.0.3",
    "typescript": "5.9.3",
    "tsx": "4.23.15",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "node-llama-cpp",
      "tree-sitter-go",
      "tree-sitter-javascript",
      "tree-sitter-python",
      "tree-sitter-rust",
      "tree-sitter-typescript"
    ]
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "markdown",
    "search",
    "fts",
    "full-text-search",
    "vector",
    "semantic-search",
    "sqlite",
    "bm25",
    "embeddings",
    "rag",
    "mcp",
    "reranking",
    "knowledge-base",
    "local-ai",
    "llm"
  ],
  "author": "Tobi Lutke <tobi@lutke.com>",
  "license": "MIT",
  "allowScripts": {
    "better-sqlite3": true
  }
}
